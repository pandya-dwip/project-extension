{
  "manifest_version": 3,
  "name": "Clair – Task & Project Tracker",
  "short_name": "Clair",
  "version": "4.3.0",
  "description": "Local-first tracker for projects, tasks, releases and test cases, with Jira sync, auto QA tasks and daily backups. Data stays local.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "alarms",
    "offscreen",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*.atlassian.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Open Clair — projects, releases & test cases"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
